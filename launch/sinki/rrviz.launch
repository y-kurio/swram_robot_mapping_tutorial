      <arg name="use_rviz"                      value="$(arg use_rviz)"/>
    </include>
  </group>

  <group ns="$(arg multi_robot)_4">

    <include file="$(find swram_robot_mapping_tutorial)/launch/sinki/newrviz.launch">
      <arg name="multi_robot"                   value="$(arg multi_robot)_4"/>
      <arg name="use_rviz"                      value="$(arg use_rviz)"/>
    </include>
  </group>

  <group ns="$(arg multi_robot)_5">

    <include file="$(find swram_robot_mapping_tutorial)/launch/sinki/newrviz.launch">
      <arg name="multi_robot"                   value="$(arg multi_robot)_5"/>
      <arg name="use_rviz"                      value="$(arg use_rviz)"/>
    </include>
  </group>

  <group ns="$(arg multi_robot)_6">

    <include file="$(find swram_robot_mapping_tutorial)/launch/sinki/newrviz.launch">
      <arg name="multi_robot"                   value="$(arg multi_robot)_6"/>
      <arg name="use_rviz"                      value="$(arg use_rviz)"/>
    </include>
  </group>

  <group ns="$(arg multi_robot)_7">

    <include file="$(find swram_robot_mapping_tutorial)/launch/sinki/newrviz.launch">
      <arg name="multi_robot"                   value="$(arg multi_robot)_7"/>
      <arg name="use_rviz"                      value="$(arg use_rviz)"/>
    </include>
  </group>

  <group ns="$(arg multi_robot)_8">

    <include file="$(find swram_robot_mapping_tutorial)/launch/sinki/newrviz.launch">
