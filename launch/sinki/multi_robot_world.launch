<launch>

    <!-- ここにGAZEBO_MODEL_PATHの追加を入れる -->
  <env name="GAZEBO_MODEL_PATH" value="$(find swram_robot_mapping_tutorial)/models:$(optenv GAZEBO_MODEL_PATH)" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <!-- 無空間環境 -->
    <!-- <arg name="world_name" value="$(find turtlebot3_gazebo)/worlds/empty.world"/> -->
    <!-- 自作環境用 -->
    <arg name="world_name" value="$(find swram_robot_mapping_tutorial)/launch/sinki/empty.world"/>
    <!-- 砂時計 -->
    <!-- <arg name="world_name" value="$(find swram_robot_mapping_tutorial)/launch/sinki/sunadokei.world"/> -->
    <!-- 横11.5,7.8m縦11ｍ,間4m -->
    <!-- <arg name="world_name" value="$(find swram_robot_mapping_tutorial)/launch/sinki/sunadokei3m.world"/> -->
    <!-- 横7,7.5m縦10ｍ,間3m -->
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <include file="$(find swram_robot_mapping_tutorial)/launch/turtlebot3_spawnvol1.launch">
      <arg name="tf_prefix"       value="robot_1"/>
      <arg name="model"           value="waffle"/>
      <arg name="x_pos"           value="8.5"/>
      <arg name="y_pos"           value="8.5"/>
      <arg name="z_pos"           value="0.0"/>
      <arg name="yaw"             value="0.00"/>
  </include>

  <include file="$(find swram_robot_mapping_tutorial)/launch/turtlebot3_spawnvol1.launch">
      <arg name="tf_prefix"       value="robot_2"/>
      <arg name="model"           value="waffle"/>
      <arg name="x_pos"           value="8.5"/>
      <arg name="y_pos"           value="12.5"/>
      <arg name="z_pos"           value="0.0"/>
      <arg name="yaw"             value="0.0"/>
  </include>

  <include file="$(find swram_robot_mapping_tutorial)/launch/turtlebot3_spawnvol1.launch">
      <arg name="tf_prefix"       value="robot_3"/>
      <arg name="model"           value="waffle"/>
      <arg name="x_pos"           value="8.5"/>
      <arg name="y_pos"           value="10.5"/>
      <arg name="z_pos"           value="0.0"/>
      <arg name="yaw"             value="0.0"/>
  </include>
  
  <include file="$(find swram_robot_mapping_tutorial)/launch/turtlebot3_spawnvol1.launch">
      <arg name="tf_prefix"       value="robot_4"/>
      <arg name="model"           value="waffle"/>
      <arg name="x_pos"           value="4.5"/>
      <arg name="y_pos"           value="10.5"/>
      <arg name="z_pos"           value="0.0"/>
      <arg name="yaw"             value="0.0"/>
  </include>
  
  <include file="$(find swram_robot_mapping_tutorial)/launch/turtlebot3_spawnvol1.launch">
      <arg name="tf_prefix"       value="robot_5"/>
      <arg name="model"           value="waffle"/>
      <arg name="x_pos"           value="4.5"/>
      <arg name="y_pos"           value="8.5"/>
      <arg name="z_pos"           value="0.0"/>
      <arg name="yaw"             value="0.0"/>
  </include>
  
  <!-- <include file="$(find swram_robot_mapping_tutorial)/launch/turtlebot3_spawnvol1.launch">
      <arg name="tf_prefix"       value="robot_6"/>
      <arg name="model"           value="waffle"/>
      <arg name="x_pos"           value="2.0"/>
      <arg name="y_pos"           value="-2.0"/>
      <arg name="z_pos"           value="0.0"/>
      <arg name="yaw"             value="0.0"/>
  </include>
  
  <include file="$(find swram_robot_mapping_tutorial)/launch/turtlebot3_spawnvol1.launch">
      <arg name="tf_prefix"       value="robot_7"/>
      <arg name="model"           value="waffle"/>
      <arg name="x_pos"           value="2.0"/>
      <arg name="y_pos"           value="2.0"/>
      <arg name="z_pos"           value="0.0"/>
      <arg name="yaw"             value="0.0"/>
  </include>
  
  <include file="$(find swram_robot_mapping_tutorial)/launch/turtlebot3_spawnvol1.launch">
      <arg name="tf_prefix"       value="robot_8"/>
      <arg name="model"           value="waffle"/>
      <arg name="x_pos"           value="-2.0"/>
      <arg name="y_pos"           value="2.0"/>
      <arg name="z_pos"           value="0.0"/>
      <arg name="yaw"             value="0.0"/>
  </include> -->

  <include file="$(find swram_robot_mapping_tutorial)/launch/turtlebot3_spawnvol1.launch">
      <arg name="tf_prefix"       value="main"/>
      <arg name="model"           value="burger"/>
      <arg name="x_pos"           value="0.0"/>
      <arg name="y_pos"           value="0.0"/>
      <arg name="z_pos"           value="0.0"/>
      <arg name="yaw"             value="0.0"/>
  </include>

</launch>